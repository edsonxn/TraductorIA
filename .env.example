# === API Keys de Google ===
# API principal (de pago o con cuota)
GOOGLE_API_KEY=

# APIs gratuitas (opcionales, se usan como fallback)
GOOGLE_API_KEY_GRATIS=
GOOGLE_API_KEY_GRATIS2=
GOOGLE_API_KEY_GRATIS3=
GOOGLE_API_KEY_GRATIS4=
GOOGLE_API_KEY_GRATIS5=

# === Modelos de Gemini ===
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
GEMINI_TTS_MODEL_FLASH=gemini-2.5-flash-preview-tts
GEMINI_TTS_MODEL_PRO=gemini-2.5-pro-preview-tts

# === Directorio de salida ===
OUTPUTS_DIR=C:\Traductor\outputs

# === Puerto del servidor ===
PORT=3001
